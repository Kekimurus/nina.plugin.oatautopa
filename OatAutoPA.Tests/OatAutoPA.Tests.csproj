<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dependency-free on purpose: builds and runs on any OS without NuGet packages or N.I.N.A.
       It compiles the plugin's Core folder directly, which has no N.I.N.A. references. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\OatAutoPA\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
