<ResourceDictionary
    x:Class="OatAutoPA.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Key must be "<AssemblyTitle>_Options"; the data context is the OatAutoPAPlugin instance.  -->
    <DataTemplate x:Key="OAT AutoPA_Options">
        <StackPanel Orientation="Vertical">
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="MinWidth" Value="260" />
                    <Setter Property="Margin" Value="0,2,8,2" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="MinWidth" Value="80" />
                    <Setter Property="Margin" Value="0,2" />
                </Style>
                <Style TargetType="CheckBox">
                    <Setter Property="Margin" Value="0,2" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </StackPanel.Resources>

            <TextBlock TextWrapping="Wrap" MaxWidth="700" Margin="0,0,0,8"
                       Text="In TPPA, set 'Polar Alignment System' to 'External: OAT AutoPA', set a non-zero alignment tolerance, leave 'Do automated adjustments' off, and run TPPA as a sequence instruction." />

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status" />
                <TextBlock Text="{Binding ControllerStatus}" MinWidth="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Learned calibration" />
                <TextBlock Text="{Binding CalibrationSummary}" MinWidth="0" TextWrapping="Wrap" MaxWidth="500" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="" />
                <Button Command="{Binding ResetCalibrationCommand}" Content="Reset learned calibration" Padding="8,2" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Offer this controller to TPPA" />
                <CheckBox IsChecked="{Binding Enabled}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Correction gain (fraction of error per step)" />
                <TextBox Text="{Binding Gain}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Maximum move per step (arcmin)" />
                <TextBox Text="{Binding MaxMoveArcMin}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Manual adjustment above (arcmin)" />
                <TextBox Text="{Binding ManualAdjustLimitArcMin}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Settle time after a move (s)" />
                <TextBox Text="{Binding SettleSeconds}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Move timeout (s)" />
                <TextBox Text="{Binding MoveTimeoutSeconds}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Invert azimuth" />
                <CheckBox IsChecked="{Binding InvertAzimuth}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Invert altitude" />
                <CheckBox IsChecked="{Binding InvertAltitude}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Detect reversed axes automatically" />
                <CheckBox IsChecked="{Binding AutoDetectDirection}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Correct moves with the learned gear response" />
                <CheckBox IsChecked="{Binding UseLearnedResponse}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Compensate learned backlash on reversals" />
                <CheckBox IsChecked="{Binding UseBacklashCompensation}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Remember calibration between sessions" />
                <CheckBox IsChecked="{Binding PersistCalibration}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Max response scatter before distrusting (0-1)" />
                <TextBox Text="{Binding MaxResponseScatter}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Smallest move used for learning (arcmin)" />
                <TextBox Text="{Binding MinLearningMoveArcMin}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
